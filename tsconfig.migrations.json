{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "CommonJS",
    "target": "ES2019",
    "moduleResolution": "node",
    "noEmit": false,
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true
  },
  "include": [
    "src/entities/**/*.ts",
    "src/migrations/**/*.ts",
    "src/lib/db.ts",
    "src/lib/db.migration.ts",
    "scripts/run-migrations.ts"
  ]
}
