{
  "crons": [
    {
      "path": "/api/cron/scheduler",
      "schedule": "0 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noimageindex" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noimageindex" }
      ]
    }
  ]
}
